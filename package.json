{
  "name": "podcast-enhancer",
  "private": true,
  "version": "0.1.0",
  "description": "Local web app that cleans up and enhances voice recordings with AI, on your own NVIDIA GPU.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c gray,blue \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch-path=server server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm run build && NODE_ENV=production node server/index.js",
    "share": "node scripts/share.mjs",
    "share:rotate": "node scripts/share.mjs --rotate",
    "setup": "bash scripts/setup.sh"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.12.8",
    "nanoid": "^5.1.16"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
